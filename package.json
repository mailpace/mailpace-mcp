{
  "name": "mailpace-mcp",
  "version": "2.0.0",
  "description": "MCP server for the MailPace Send API, Domains API, and Email Status API",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "mailpace-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build",
    "dev": "tsx index.ts",
    "start": "node build/index.js",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mailpace/mailpace-mcp.git"
  },
  "homepage": "https://github.com/mailpace/mailpace-mcp#readme",
  "bugs": {
    "url": "https://github.com/mailpace/mailpace-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mailpace",
    "email",
    "transactional-email"
  ],
  "author": "MailPace",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.27",
    "tsx": "^4.20.6",
    "typescript": "^5.8.2"
  }
}
